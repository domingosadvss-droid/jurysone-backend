// ─── Intimações / Diário Oficial ──────────────────────────────────────────────

model Intimacao {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])

  fonte          FonteIntimacao @default(DJE)
  tribunal       String
  diarioNome     String?
  edicao         String?
  dataPublicacao DateTime
  dataCaptura    DateTime       @default(now())

  titulo         String
  conteudo       String  @db.Text
  conteudoResumo String? @db.Text
  urlOrigem      String?
  paginaDiario   String?
  caderno        String?

  nomesEncontrados Json?
  numeroProcesso   String?

  status    StatusIntimacao @default(NAO_LIDA)
  lida      Boolean         @default(false)
  lidaEm    DateTime?
  lidaPorId String?
  lidaPor   Usuario?        @relation("IntimacoesLidas", fields: [lidaPorId], references: [id])

  prazoIdentificado Int?
  prazoFatal        DateTime?

  processoId      String?
  processo        Processo?            @relation(fields: [processoId], references: [id])
  clienteId       String?
  cliente         Cliente?             @relation(fields: [clienteId], references: [id])
  monitoramentoId String?
  monitoramento   DiarioMonitoramento? @relation(fields: [monitoramentoId], references: [id])

  providencia   String?   @db.Text
  providenciaEm DateTime?

  // Etapa 4: captura pelo DJEN (Comunica PJe)
  djenId             String?
  djenHash           String?
  tipoComunicacao    String?
  tipoDocumento      String?
  orgao              String?
  classe             String?
  destinatarios      Json?
  advogados          Json?
  // usuários do escritório cuja OAB foi intimada
  intimadosIds       String[] @default([])
  categorias         String[] @default([])
  cancelada          Boolean  @default(false)
  motivoCancelamento String?
  semVinculo         Boolean  @default(false)
  sugestoesVinculo   Json?
  // processo particular de parceiro (fora do escritório): sigiloso, salvo coincidência
  particular         Boolean  @default(false)
  coincidencias      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([escritorioId, djenId])
  @@index([escritorioId])
  @@index([dataPublicacao])
  @@index([status])
  @@index([tribunal])
  @@index([processoId])
  @@map("intimacoes")
}

model DiarioMonitoramento {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])

  nome  String
  ativo Boolean           @default(true)
  tipo  TipoMonitoramento @default(OAB)

  termoBusca   String
  oabNumero    String?
  oabEstado    String?
  nomeAdvogado String?
  cpfCnpj      String?

  tribunais Json
  cadernos  Json?

  notificarEmail    Boolean  @default(true)
  notificarWhatsapp Boolean  @default(false)
  emailsAlerta      Json?
  responsavelId     String?
  responsavel       Usuario? @relation("MonitoramentosResponsavel", fields: [responsavelId], references: [id])

  ultimaExecucao DateTime?
  totalCapturado Int       @default(0)
  totalNaoLido   Int       @default(0)
  erroUltimaSync String?

  criadoPorId String
  criadoPor   Usuario @relation("MonitoramentosCriados", fields: [criadoPorId], references: [id])

  intimacoes Intimacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@map("diario_monitoramentos")
}

model DiarioExecucaoLog {
  id              String   @id @default(uuid())
  escritorioId    String
  tribunal        String
  dataEdicao      DateTime
  status          String
  totalEncontrado Int      @default(0)
  duracaoMs       Int?
  erroMsg         String?  @db.Text
  monitoramentoId String?

  createdAt DateTime @default(now())

  @@index([escritorioId])
  @@index([tribunal])
  @@map("diario_execucao_logs")
}

enum FonteIntimacao {
  DJE
  DOU
  DODF
  DOESP
  DOUDF
  PJE
  ESAJ
  OUTROS
  DJEN
}

enum StatusIntimacao {
  NAO_LIDA
  LIDA
  RESPONDIDA
  ARQUIVADA
  PRAZO_CRIADO
}

enum TipoMonitoramento {
  OAB
  NOME
  CPF_CNPJ
  NUMERO_PROCESSO
  PALAVRA_CHAVE
}

// ─── Peticionamento Eletrônico ────────────────────────────────────────────────

model Protocolo {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  processoId   String?
  processo     Processo?  @relation(fields: [processoId], references: [id])
  advogadoId   String
  advogado     Usuario    @relation("ProtocolosAdvogado", fields: [advogadoId], references: [id])

  tribunal         String
  tipoPeticao      String // 'inicial', 'intermediaria', 'recurso', etc.
  arquivoUrl       String?
  numeroProtocolo  String?
  status           String    @default("pendente") // pendente | enviado | protocolado | erro
  respostaTribunal Json?
  dataProtocolo    DateTime?
  erroMensagem     String?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([processoId])
  @@map("protocolos")
}

// ─── Parceiros ────────────────────────────────────────────────────────────────

model Parceiro {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])

  nome                 String
  cpfCnpj              String?
  oabNumero            String?
  oabEstado            String?
  areaAtuacao          String?
  percentualHonorarios Decimal? @db.Decimal(5, 2)

  email    String?
  telefone String?
  whatsapp String?

  endereco String?
  cidade   String?
  estado   String?
  cep      String?

  banco    String?
  agencia  String?
  conta    String?
  pixChave String?

  observacoes String? @db.Text
  ativo       Boolean @default(true)

  criadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@map("parceiros")
}

// ─── Etapa 1: papéis no processo, cota-parte e repasses ──────────────────────

/// Quem atuou em cada processo e com qual papel (base da cota-parte)
model ParticipacaoProcesso {
  id               String   @id @default(uuid())
  escritorioId     String
  processoId       String
  processo         Processo @relation(fields: [processoId], references: [id])
  usuarioId        String?
  parceiroId       String?
  papel            String // INDICACAO | PARTICIPACAO
  percentualCustom Decimal? @db.Decimal(5, 2)
  observacao       String?
  createdAt        DateTime @default(now())

  @@index([escritorioId])
  @@index([processoId])
  @@index([usuarioId])
  @@index([parceiroId])
  @@map("participacoes_processo")
}

/// Percentual por papel × tipo de honorário (padrão do escritório ou por pessoa)
model RegraCotaParte {
  id            String   @id @default(uuid())
  escritorioId  String
  usuarioId     String?
  parceiroId    String?
  papel         String // INDICACAO | PARTICIPACAO
  tipoHonorario String   @default("TODOS")
  percentual    Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId])
  @@map("regras_cota_parte")
}

/// Fechamento manual de período para repasse aos beneficiários
model FechamentoRepasse {
  id              String        @id @default(uuid())
  escritorioId    String
  ate             DateTime
  aliquotaImposto Decimal       @db.Decimal(5, 2)
  criadoPorId     String?
  itens           ItemRepasse[]
  createdAt       DateTime      @default(now())

  @@index([escritorioId])
  @@map("fechamentos_repasse")
}

model ItemRepasse {
  id              String               @id @default(uuid())
  escritorioId    String
  fechamentoId    String
  fechamento      FechamentoRepasse    @relation(fields: [fechamentoId], references: [id])
  lancamentoId    String
  lancamento      LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id])
  beneficiarioKey String // "u:<usuarioId>" ou "p:<parceiroId>"
  usuarioId       String?
  parceiroId      String?
  papel           String
  percentual      Decimal              @db.Decimal(5, 2)
  valorBruto      Decimal              @db.Decimal(12, 2)
  taxaGateway     Decimal              @db.Decimal(12, 2)
  imposto         Decimal              @db.Decimal(12, 2)
  base            Decimal              @db.Decimal(12, 2)
  valor           Decimal              @db.Decimal(12, 2)
  repassadoEm     DateTime?
  comprovanteUrl  String?
  createdAt       DateTime             @default(now())

  @@unique([lancamentoId, beneficiarioKey])
  @@index([escritorioId])
  @@index([fechamentoId])
  @@map("itens_repasse")
}

/// Impedimentos pessoais: partes conciliadas (1 ano), tribunal desportivo, juízo onde atua
model Impedimento {
  id             String    @id @default(uuid())
  escritorioId   String
  usuarioId      String
  tipo           String // CONCILIACAO | TJD | JUIZO | OUTRO
  nome           String?
  cpfCnpj        String?
  orgao          String?
  descricao      String?
  dataEvento     DateTime?
  validoAte      DateTime?
  // Etapa 4: conciliação lançada pelo número do processo
  processoNumero String?
  createdAt      DateTime  @default(now())

  @@index([escritorioId])
  @@index([usuarioId])
  @@map("impedimentos")
}

// ─── Etapa 2: linha de produção ──────────────────────────────────────────────

/// Modelo de linha de produção por tipo de caso (ex.: "Imobiliário — revisão contratual")
model ModeloLinha {
  id           String          @id @default(uuid())
  escritorioId String
  codigo       String // identificador estável (ex.: IMOB_REVISAO_CONTRATUAL)
  nome         String
  area         String
  descricao    String?
  ativo        Boolean         @default(true)
  versao       Int             @default(1)
  etapas       EtapaModelo[]
  linhas       LinhaProcesso[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([escritorioId, codigo])
  @@index([escritorioId])
  @@map("modelos_linha")
}

model EtapaModelo {
  id                  String      @id @default(uuid())
  modeloId            String
  modelo              ModeloLinha @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  ordem               Int
  nome                String
  descricao           String?
  // ADVOGADO_RESPONSAVEL | ESTAGIARIO | ADMIN | USUARIO
  responsavelTipo     String      @default("ADVOGADO_RESPONSAVEL")
  responsavelPadraoId String?
  // Quando a etapa depende de alguém de fora (cliente, técnico, contador, cartório)
  aguardando          String?
  prazoDias           Int         @default(5)
  opcional            Boolean     @default(false)
  // [{ id, texto, obrigatorio }]
  checklist           Json?

  @@index([modeloId])
  @@map("etapas_modelo")
}

/// Linha de produção aplicada a um processo
model LinhaProcesso {
  id           String       @id @default(uuid())
  escritorioId String
  processoId   String
  processo     Processo     @relation(fields: [processoId], references: [id])
  modeloId     String
  modelo       ModeloLinha  @relation(fields: [modeloId], references: [id])
  modeloVersao Int
  status       String       @default("ATIVA") // ATIVA | CONCLUIDA | CANCELADA
  iniciadaPor  String?
  concluidaEm  DateTime?
  etapas       EtapaLinha[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([escritorioId])
  @@index([processoId])
  @@map("linhas_processo")
}

model EtapaLinha {
  id            String        @id @default(uuid())
  escritorioId  String
  linhaId       String
  linha         LinhaProcesso @relation(fields: [linhaId], references: [id], onDelete: Cascade)
  ordem         Int
  nome          String
  descricao     String?
  aguardando    String?
  opcional      Boolean       @default(false)
  prazoDias     Int           @default(5)
  responsavelId String?
  // PENDENTE | EM_ANDAMENTO | CONCLUIDA | PULADA
  status        String        @default("PENDENTE")
  // [{ id, texto, obrigatorio, feito, feitoEm, feitoPorId }]
  checklist     Json?
  iniciadaEm    DateTime?
  prazoEm       DateTime?
  concluidaEm   DateTime?
  concluidaPor  String?
  observacao    String?
  alertadoEm    DateTime?

  @@index([escritorioId, status])
  @@index([linhaId])
  @@index([responsavelId, status])
  @@map("etapas_linha")
}

// ─── Etapa 3: pacote de contratação e assinatura ─────────────────────────────

model PacoteAssinatura {
  id             String    @id @default(uuid())
  escritorioId   String
  processoId     String
  etapaId        String?
  provedor       String // ZAPSIGN | SIMULADO
  status         String    @default("RASCUNHO") // RASCUNHO | ENVIADO | ASSINADO | RECUSADO | CANCELADO
  externoId      String?
  linkAssinatura String?
  // [{ nome, email, telefone, url }]
  signatarios    Json?
  // [{ tipo, nome, documentoId, assinatura, assinadoDocumentoId }]
  documentos     Json
  criadoPorId    String?
  enviadoEm      DateTime?
  assinadoEm     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([escritorioId])
  @@index([processoId])
  @@index([externoId])
  @@map("pacotes_assinatura")
}

// ─── Etapa 4: publicações (DJEN), prazos, dativa ─────────────────────────────

/// Dias sem expediente cadastrados pelo escritório (os nacionais o sistema já conhece)
model FeriadoCalendario {
  id           String    @id @default(uuid())
  escritorioId String
  // MUNICIPAL | ESTADUAL | SUSPENSAO | FORENSE | OUTRO
  tipo         String
  data         DateTime  @db.Date
  dataFim      DateTime? @db.Date
  // tribunal (TJSC, TRT12, TRF4...) ou nulo = todos
  tribunal     String?
  // município/comarca (feriado municipal) ou nulo = todas
  comarca      String?
  descricao    String
  criadoPorId  String?
  createdAt    DateTime  @default(now())

  @@index([escritorioId, data])
  @@map("feriados_calendario")
}

/// Situação da captura do DJEN por advogado (OAB)
model EstadoCapturaDjen {
  id                String    @id @default(uuid())
  escritorioId      String
  usuarioId         String
  oab               String
  uf                String
  // dia até o qual as publicações já foram capturadas
  coberturaAte      DateTime? @db.Date
  ultimaTentativaEm DateTime?
  ultimoSucessoEm   DateTime?
  ultimoErro        String?
  falhaDesde        DateTime?
  alertaEnviadoEm   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([escritorioId, usuarioId])
  @@map("estado_captura_djen")
}

/// Caso de advocacia dativa (honorários pagos pelo Estado, só do advogado nomeado)
model CasoDativa {
  id                      String    @id @default(uuid())
  escritorioId            String
  processoId              String    @unique
  advogadoId              String
  // DJEN | AJG_EMAIL | MANUAL
  fonte                   String
  origemRef               String?
  // NOMEADO | ACEITO | RECUSADO | EM_ATUACAO | AGUARDANDO_FIXACAO | AGUARDANDO_PAGAMENTO | PAGO | ENCERRADO
  status                  String    @default("NOMEADO")
  nomeadoEm               DateTime
  comarca                 String?
  materia                 String? // CRIMINAL | CIVEL | OUTRA
  referenciaAjg           String?
  aceiteAte               DateTime?
  aceitoEm                DateTime?
  recusadoEm              DateTime?
  motivoRecusa            String?
  conflitos               Json?
  reuPreso                Boolean   @default(false)
  presoDesde              DateTime?
  ultimaRevisaoPreventiva DateTime?
  proximoAlertaPreventiva DateTime?
  sentencaEm              DateTime?
  honorariosFixadosEm     DateTime?
  valorFixado             Decimal?  @db.Decimal(12, 2)
  certidaoEm              DateTime?
  pedidoPagamentoEm       DateTime?
  pagoEm                  DateTime?
  valorPago               Decimal?  @db.Decimal(12, 2)
  lancamentoId            String?
  observacao              String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([escritorioId, status])
  @@index([advogadoId])
  @@map("casos_dativa")
}

/// Mensagem ao cliente por WhatsApp: rascunho que pede aprovação ou envio agendado
model MensagemCliente {
  id               String    @id @default(uuid())
  escritorioId     String
  // AVISO_AUDIENCIA | LEMBRETE_AUDIENCIA | MARCO_PROCESSO | APRESENTACAO_DATIVA
  tipo             String
  // chave de idempotência (ex.: "aud:<eventoId>:aviso")
  chave            String
  clienteId        String?
  processoId       String?
  origemId         String?
  telefone         String?
  texto            String    @db.Text
  // RASCUNHO | AGENDADA | ENVIADA | FALHOU | DESCARTADA
  status           String
  precisaAprovacao Boolean   @default(false)
  responsavelId    String?
  aprovadaPorId    String?
  aprovadaEm       DateTime?
  enviarEm         DateTime?
  enviadaEm        DateTime?
  tentativas       Int       @default(0)
  erro             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([escritorioId, chave])
  @@index([escritorioId, status, enviarEm])
  @@map("mensagens_cliente")
}

/// Importação dos processos antigos: itens que esperam decisão do advogado
model PendenciaImportacao {
  id                String    @id @default(uuid())
  escritorioId      String
  usuarioId         String
  // DECIDIR_ANTIGO | CONFIRMAR_CLIENTE
  tipo              String
  numeroProcesso    String
  tribunal          String?
  orgao             String?
  classe            String?
  ultimaPublicacao  DateTime?
  partes            Json?
  clienteSugeridoId String?
  motivo            String?
  // PENDENTE | IMPORTADO | DESCARTADO
  status            String    @default("PENDENTE")
  processoId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([escritorioId, usuarioId, numeroProcesso])
  @@index([escritorioId, status])
  @@map("pendencias_importacao")
}

/// Varredura de prompt injection de arquivo vindo de fora, antes de a IA ler
model VarreduraDocumento {
  id            String    @id @default(uuid())
  escritorioId  String
  documentoId   String?
  processoId    String?
  nomeArquivo   String
  hashSha256    String
  // LIMPO | ACHADOS | INCONCLUSIVO
  resultado     String
  achados       Json?
  resumo        String?
  // PENDENTE | LIBERADO | DESCARTADO (só quando há achados)
  decisao       String?
  decididoPorId String?
  decididoEm    DateTime?
  createdAt     DateTime  @default(now())

  @@index([escritorioId])
  @@index([documentoId])
  @@map("varreduras_documento")
}

/// Rascunho de peça preparado pela IA a partir da cópia dos autos
model RascunhoPeca {
  id           String    @id @default(uuid())
  escritorioId String
  processoId   String
  documentoId  String
  varreduraId  String?
  tipoPeca     String
  // AGUARDANDO_LIBERACAO | GERANDO | PRONTO | ERRO | SEM_IA | DESCARTADO
  status       String
  texto        String?   @db.Text
  modelo       String?
  erro         String?
  prazoId      String?
  criadoPorId  String?
  geradoEm     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([escritorioId, processoId])
  @@map("rascunhos_peca")
}

// ═══════════════════════ ETAPA 5 — CALCULADORAS ═══════════════════════════

/// Cache dos índices econômicos do Banco Central (SGS), por mês
model IndiceEconomico {
  id          String   @id @default(uuid())
  // código da série no SGS (ex.: "433" = IPCA)
  serie       String
  // AAAA-MM
  competencia String
  // valor em % (variação ou taxa do mês)
  valor       Decimal  @db.Decimal(14, 6)
  obtidoEm    DateTime @default(now())

  @@unique([serie, competencia])
  @@map("indices_economicos")
}

/// Cálculo guardado no caso (distrato, financiamento, trabalhista etc.)
model Calculo {
  id             String    @id @default(uuid())
  escritorioId   String
  processoId     String?
  clienteId      String?
  // DISTRATO | ATRASO_OBRA | FINANCIAMENTO | TRABALHISTA | DEBITO | LOCACAO | PENSAO | INSS | VALOR_CAUSA
  tipo           String
  titulo         String
  criadoPorId    String
  responsavelId  String?
  versaoAtual    Int       @default(1)
  // atualização mensal automática com os índices novos (143)
  atualizarAuto  Boolean   @default(true)
  ultimaAtualizacaoEm DateTime?
  arquivado      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versoes        CalculoVersao[]

  @@index([escritorioId, tipo])
  @@index([processoId])
  @@map("calculos")
}

/// Cada versão do cálculo: parâmetros, resultado e índices usados. A versão juntada nunca muda.
model CalculoVersao {
  id            String    @id @default(uuid())
  calculoId     String
  calculo       Calculo   @relation(fields: [calculoId], references: [id], onDelete: Cascade)
  numero        Int
  // CRIACAO | AJUSTE_MANUAL | AJUSTE_CHAT | ATUALIZACAO_MENSAL
  origem        String
  parametros    Json
  resultado     Json
  totalPrincipal Decimal? @db.Decimal(16, 2)
  dataBase      DateTime  @db.Date
  indicesAte    String?
  mensagemChat  String?   @db.Text
  explicacaoIa  String?   @db.Text
  juntada       Boolean   @default(false)
  juntadaEm     DateTime?
  juntadaPorId  String?
  documentosIds String[]  @default([])
  criadoPorId   String?
  createdAt     DateTime  @default(now())

  @@unique([calculoId, numero])
  @@map("calculos_versoes")
}

/// Leitura de pagamentos por IA (contrato, extrato, comprovantes) depois da varredura
model ExtracaoPagamentos {
  id            String    @id @default(uuid())
  escritorioId  String
  processoId    String?
  usuarioId     String
  nomeArquivo   String
  varreduraId   String?
  // AGUARDANDO_LIBERACAO | PROCESSANDO | AGUARDANDO_CONFERENCIA | CONFERIDA | ERRO | DESCARTADA | SEM_IA
  status        String
  arquivo       Bytes?
  pagamentos    Json?
  observacoes   String?   @db.Text
  modelo        String?
  erro          String?
  conferidaPorId String?
  conferidaEm   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([escritorioId, status])
  @@map("extracoes_pagamentos")
}

/// Tabela de custas cadastrada pelo escritório (ex.: TJSC), por faixa de valor da causa
model CustasFaixa {
  id           String   @id @default(uuid())
  escritorioId String
  tribunal     String   @default("TJSC")
  // INICIAL | RECURSO | OUTRA
  ato          String   @default("INICIAL")
  valorDe      Decimal  @db.Decimal(16, 2)
  valorAte     Decimal? @db.Decimal(16, 2)
  // valor fixo da faixa e/ou percentual sobre o valor da causa
  valorFixo    Decimal? @db.Decimal(14, 2)
  percentual   Decimal? @db.Decimal(8, 4)
  minimo       Decimal? @db.Decimal(14, 2)
  maximo       Decimal? @db.Decimal(14, 2)
  vigenciaDe   DateTime @db.Date
  fonte        String?
  createdAt    DateTime @default(now())

  @@index([escritorioId, tribunal, ato])
  @@map("custas_faixas")
}

// ═══════════════════════════════════════════════════════════════════════════
// WHATSAPP OFICIAL (Cloud API da Meta, com coexistência) — caixa de conversas
// Cada escritório conecta o próprio número (Embedded Signup); o token fica cifrado.
// ═══════════════════════════════════════════════════════════════════════════

model WhatsappConexao {
  id                   String    @id @default(uuid())
  escritorioId         String
  phoneNumberId        String    @unique
  wabaId               String
  numeroExibicao       String?
  nomeExibicao         String?
  tokenCifrado         String
  // TESTE (número de teste da Meta) | EMBEDDED_SIGNUP | MANUAL
  origem               String    @default("MANUAL")
  coexistencia         Boolean   @default(false)
  historicoImportadoEm DateTime?
  pastaRaizId          String? // pasta "WhatsApp" no armazenamento do escritório (evita duplicar no Drive)
  // Cada login conecta o PRÓPRIO número (22/11/2026): só o dono e quem ele liberar veem a caixa
  usuarioId            String?
  acessoIds            String[]  @default([])
  // Atendimento automático (IA) ligado neste número; ativadoEm marca o que conta como "contato novo"
  iaAtivo              Boolean   @default(false)
  iaAtivadoEm          DateTime?
  ativo                Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  conversas WhatsappConversa[]

  @@index([escritorioId])
  @@index([usuarioId])
  @@map("whatsapp_conexoes")
}

model WhatsappConversa {
  id               String    @id @default(uuid())
  escritorioId     String
  conexaoId        String
  conexao          WhatsappConexao @relation(fields: [conexaoId], references: [id])
  telefone         String // só dígitos, com DDI (ex.: 5547999999999)
  nomeContato      String?
  clienteId        String?
  ultimaMensagemEm DateTime?
  ultimaEntradaEm  DateTime? // última mensagem do contato: abre a janela de 24 h da Meta
  naoLidas         Int       @default(0)
  pastaArquivosId  String? // pasta do contato dentro de "WhatsApp"
  // Atendimento automático (IA): null = segue a regra geral | AUTO = ligado nesta conversa |
  // PAUSADA = advogado assumiu | ENCAMINHADA = a IA passou para o advogado e parou de responder
  iaStatus         String?
  iaMotivo         String?
  // Lembretes ao cliente que parou de responder (zerados quando o cliente escreve)
  lembretesEnviados Int      @default(0)
  ultimoLembreteEm DateTime?
  // Quando a IA já analisou o atendimento para sugerir melhorias no catálogo
  aprendizadoEm    DateTime?
  createdAt        DateTime  @default(now())

  mensagens WhatsappMensagemCaixa[]

  @@unique([conexaoId, telefone])
  @@index([escritorioId, ultimaMensagemEm])
  @@map("whatsapp_conversas")
}

model WhatsappMensagemCaixa {
  id             String   @id @default(uuid())
  escritorioId   String
  conversaId     String
  conversa       WhatsappConversa @relation(fields: [conversaId], references: [id])
  wamid          String?  @unique // id da mensagem na Meta
  // ENTRADA (do contato) | SAIDA (do escritório)
  direcao        String
  // CLIENTE | JURYSONE | CELULAR (enviada pelo app do celular, coexistência) | HISTORICO
  origem         String
  // text | image | document | audio | video | sticker | location | contacts | interactive | button | reaction | unsupported
  tipo           String
  texto          String?  @db.Text
  midiaId        String?
  midiaMime      String?
  midiaNome      String?
  arquivoId      String? // caminho/ID no armazenamento do escritório (Drive ou local)
  arquivoTamanho Int?
  // recebida | enviada | entregue | lida | falhou
  status         String   @default("recebida")
  erro           String?
  enviadaPorId   String?
  dataHora       DateTime
  createdAt      DateTime @default(now())

  @@index([conversaId, dataHora])
  @@map("whatsapp_mensagens_caixa")
}

/// Aprendizado do atendimento: quando o advogado responde numa conversa que a IA atendia,
/// o par "mensagem do cliente → resposta do advogado" vira exemplo. Só os APROVADOS entram
/// nas regras da IA (o advogado revisa, pode editar e descartar).
model AtendimentoExemplo {
  id                  String    @id @default(uuid())
  escritorioId        String
  conversaId          String?
  /// mensagem do advogado que originou o exemplo (evita duplicar)
  mensagemAdvogadoId  String?   @unique
  perguntaCliente     String    @db.Text
  respostaAdvogado    String    @db.Text
  /// o que a IA tinha respondido antes, quando houver (para comparar)
  respostaIa          String?   @db.Text
  /// PENDENTE | APROVADO | DESCARTADO
  status              String    @default("PENDENTE")
  criadoPorId         String?
  decididoPorId       String?
  decididoEm          DateTime?
  createdAt           DateTime  @default(now())

  @@index([escritorioId, status])
  @@map("atendimento_exemplos")
}

// ─── Etapa A: uso e custo da IA (Claude) ─────────────────────────────────────
/// Uma linha por chamada ao Claude (ou por bloqueio pelo limite mensal)
model IaUso {
  id                 String   @id @default(uuid())
  escritorioId       String
  /// nome da tarefa (ex.: conversa_whatsapp, rascunho_peca_dativa, resumo_cliente, calculo_pagamentos)
  tarefa             String
  /// CONVERSA (nunca para pelo limite) | PESADA (pausa quando o limite é atingido)
  categoria          String
  modelo             String
  tokensEntrada      Int      @default(0)
  tokensSaida        Int      @default(0)
  tokensCacheLeitura Int      @default(0)
  tokensCacheEscrita Int      @default(0)
  custoUsd           Decimal  @default(0) @db.Decimal(14, 6)
  /// cotação do dólar usada na conversão (PTAX/BCB ou valor de reserva)
  cotacaoUsd         Decimal? @db.Decimal(10, 4)
  custoBrl           Decimal  @default(0) @db.Decimal(14, 4)
  /// OK | ERRO | BLOQUEADO
  status             String   @default("OK")
  erro               String?
  processoId         String?
  atendimentoId      String?
  conversaId         String?
  usuarioId          String?
  createdAt          DateTime @default(now())

  @@index([escritorioId, createdAt])
  @@index([processoId])
  @@map("ia_uso")
}

// ─── Etapa B: catálogo de serviços (o que a IA usa no atendimento) ───────────
/// Um serviço que o escritório oferece: preço SUGERIDO (nunca vai ao cliente sem o advogado
/// confirmar), documentos, perguntas da triagem, orientações e respostas frequentes
model ServicoCatalogo {
  id                String    @id @default(uuid())
  escritorioId      String
  codigo            String
  nome              String
  area              String
  descricao         String?   @db.Text
  /// modelo da linha de produção que o caso segue depois de contratado
  modeloLinhaCodigo String?
  responsavelId     String?
  precoSugerido     Decimal?  @db.Decimal(12, 2)
  /// FIXO | EXITO | FIXO_MAIS_EXITO | MENSAL | POR_ATO
  tipoHonorario     String?
  percentualExito   Decimal?  @db.Decimal(5, 2)
  /// [{ texto, obrigatorio }]
  documentos        Json      @default("[]")
  /// [{ pergunta, obrigatoria }]
  perguntas         Json      @default("[]")
  orientacoes       String?   @db.Text
  /// [{ pergunta, resposta }]
  faq               Json      @default("[]")
  palavrasChave     String[]  @default([])
  /// ATIVO | INATIVO
  status            String    @default("ATIVO")
  /// PADRAO | MANUAL | IA
  origem            String    @default("MANUAL")
  versao            Int       @default(1)
  aprovadoPorId     String?
  aprovadoEm        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  versoes           ServicoCatalogoVersao[]

  @@unique([escritorioId, codigo])
  @@index([escritorioId, status])
  @@map("catalogo_servicos")
}

/// Histórico: cada alteração aprovada guarda a versão anterior inteira
model ServicoCatalogoVersao {
  id            String          @id @default(uuid())
  servicoId     String
  servico       ServicoCatalogo @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  versao        Int
  dados         Json
  alteradoPorId String?
  motivo        String?
  createdAt     DateTime        @default(now())

  @@index([servicoId, versao])
  @@map("catalogo_servicos_versoes")
}

/// Sugestão para o catálogo (da IA, ao aprender nas conversas, ou de um usuário):
/// só passa a valer depois que um advogado de gestão aprova
model SugestaoCatalogo {
  id             String    @id @default(uuid())
  escritorioId   String
  /// NOVO_SERVICO | AJUSTE
  tipo           String
  servicoId      String?
  /// NOVO_SERVICO: o serviço inteiro; AJUSTE: só os campos alterados
  dados          Json
  justificativa  String?   @db.Text
  /// IA | USUARIO
  origem         String    @default("IA")
  conversaId     String?
  atendimentoId  String?
  criadoPorId    String?
  /// PENDENTE | APROVADA | RECUSADA
  status         String    @default("PENDENTE")
  decididoPorId  String?
  decididoEm     DateTime?
  motivoDecisao  String?
  createdAt      DateTime  @default(now())

  @@index([escritorioId, status])
  @@map("catalogo_sugestoes")
}
