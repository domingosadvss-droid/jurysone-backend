generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuários ──────────────────────────────────────────────────────────────

model Usuario {
  id               String    @id @default(uuid())
  nome             String
  email            String    @unique
  senha            String
  oabNumero        String?
  oabEstado        String?
  // CPF do advogado: exigido para assinar com certificado digital (Certisign)
  cpf              String?
  telefone         String?
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  twoFactorSecret  String?
  roles            String    @default("ADVOGADO")
  ativo            Boolean   @default(true)
  refreshTokenHash String?

  // "Esqueceu a senha?": hash SHA-256 do código enviado por e-mail (o código em si nunca é salvo)
  resetSenhaHash     String?   @unique
  resetSenhaExpiraEm DateTime?

  // Perfil externo (PARCEIRO) vinculado ao cadastro de parceiro
  parceiroId        String?
  // Termo de ciência e responsabilidade (associados e parceiros)
  termoAceitoEm     DateTime?
  termoDocumentoUrl String?

  // Etapa 4: Google Agenda pessoal do advogado (refresh token cifrado)
  googleAgendaToken       String?
  googleAgendaId          String?
  googleAgendaConectadoEm DateTime?

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])

  tokensRefresh             TokenRefresh[]
  processosResponsavel      Processo[]               @relation("ResponsavelProcesso")
  tarefasAtribuidas         Tarefa[]                 @relation("TarefasAtribuidas")
  eventosCriados            Evento[]                 @relation("EventosCriados")
  eventosResponsavel        EventoResponsavel[]      @relation("EventosResponsavel")
  envelopesCriados          EsignEnvelope[]          @relation("EnvelopesCriados")
  sessoesTimer              SessaoTimer[]            @relation("SessoesTimer")
  intimacoesLidas           Intimacao[]              @relation("IntimacoesLidas")
  monitoramentosResponsavel DiarioMonitoramento[]    @relation("MonitoramentosResponsavel")
  monitoramentosCriados     DiarioMonitoramento[]    @relation("MonitoramentosCriados")
  interacoesIA              InteracaoIA[]
  logsAuditoria             LogAuditoria[]
  mensagensPortal           MensagemPortal[]
  entradasTempo             EntradaTempo[]
  metasTempo                MetaTempo[]
  notificacoes              Notificacao[]
  preferenciasNotificacao   PreferenciaNotificacao[]
  inscricoesPush            InscricaoPush[]
  mensagensWhatsapp         WhatsappMessage[]
  automacoes                Automacao[]
  dashboardsAnalytics       DashboardAnalytics[]
  protocolosAdvogado        Protocolo[]              @relation("ProtocolosAdvogado")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([escritorioId])
  @@map("users")
}

// ─── Escritórios ────────────────────────────────────────────────────────────

model Escritorio {
  id          String  @id @default(uuid())
  nome        String
  cnpj        String? @unique
  logoUrl     String?
  dominio     String? @unique
  corPrimaria String?

  usuarios               Usuario[]
  processos              Processo[]
  clientes               Cliente[]
  eventos                Evento[]
  tarefas                Tarefa[]
  documentos             Documento[]
  pagamentos             Pagamento[]
  assinatura             Assinatura?
  configuracoes          Configuracao[]
  interacoesIA           InteracaoIA[]
  logsAuditoria          LogAuditoria[]
  parceiros              Parceiro[]
  respostasNps           RespostaNps[]
  envelopesEsign         EsignEnvelope[]
  metasTempo             MetaTempo[]
  notificacoes           Notificacao[]
  mensagensWhatsapp      WhatsappMessage[]
  templatesWhatsapp      WhatsappTemplate[]
  automacoesWhatsapp     WhatsappAutomation[]
  monitoramentosDatajud  DatajudMonitoramento[]
  automacoes             Automacao[]
  intimacoes             Intimacao[]
  monitoramentosDiario   DiarioMonitoramento[]
  atendimentos           Atendimento[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  prazos                 Prazo[]
  registrosCrm           RegistroCrm[]
  historicoStatus        HistoricoStatus[]
  protocolos             Protocolo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offices")
}

// ─── Assinaturas ────────────────────────────────────────────────────────────

model Assinatura {
  id                   String           @id @default(uuid())
  escritorioId         String           @unique
  escritorio           Escritorio       @relation(fields: [escritorioId], references: [id])
  status               StatusAssinatura @default(TRIAL)
  nomePlano            String           @default("PRO")
  trialVenceEm         DateTime?
  periodoAtualInicio   DateTime?
  periodoAtualFim      DateTime?
  canceladoEm          DateTime?
  stripeSubscriptionId String?

  pagamentos Pagamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum StatusAssinatura {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

// ─── Pagamentos ──────────────────────────────────────────────────────────────

model Pagamento {
  id            String          @id @default(uuid())
  escritorioId  String
  escritorio    Escritorio      @relation(fields: [escritorioId], references: [id])
  assinaturaId  String?
  assinatura    Assinatura?     @relation(fields: [assinaturaId], references: [id])
  valorCentavos Int
  moeda         String          @default("BRL")
  status        StatusPagamento @default(PENDENTE)
  metodo        MetodoPagamento @default(CARTAO_CREDITO)
  gatewayId     String?
  urlFatura     String?
  pagoEm        DateTime?
  vencimento    DateTime?

  createdAt DateTime @default(now())

  @@index([escritorioId])
  @@map("payments")
}

enum StatusPagamento {
  PENDENTE
  PAGO
  FALHOU
  ESTORNADO
}

enum MetodoPagamento {
  CARTAO_CREDITO
  BOLETO
  PIX
}

// ─── Clientes ────────────────────────────────────────────────────────────────

model Cliente {
  id             String      @id @default(uuid())
  escritorioId   String
  escritorio     Escritorio  @relation(fields: [escritorioId], references: [id])
  nome           String
  tipo           TipoCliente @default(PF)
  cpfCnpj        String?
  cpf            String?
  rg             String?
  dataNascimento DateTime?
  email          String?
  telefone       String?
  endereco       String?
  cidade         String?
  estado         String?
  cep            String?
  observacoes    String?     @db.Text
  status         String      @default("ativo")
  ativo          Boolean     @default(true)
  deletedAt      DateTime?

  // Felicitações e origem do cliente
  temFilhos          Boolean?
  origem             String? // INDICACAO_CLIENTE | INSTAGRAM | MACONARIA_NETWORKING | PARCEIRO | GOOGLE | DATIVA | OUTRO
  indicadoPor        String?
  driveFolderId      String?
  // Etapa 4: cliente criado pela importação ou pela dativa, faltando dados
  cadastroIncompleto Boolean  @default(false)

  processos              Processo[]
  eventos                Evento[]
  usuariosPortal         UsuarioPortal[]
  mensagensWhatsapp      WhatsappMessage[]
  intimacoes             Intimacao[]
  atendimentos           Atendimento[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  pastasCliente          PastaCliente[]
  registrosCrm           RegistroCrm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([cpfCnpj])
  @@map("clients")
}

enum TipoCliente {
  PF
  PJ
}

// ─── Processos ────────────────────────────────────────────────────────────────

model Processo {
  id           String         @id @default(uuid())
  escritorioId String
  escritorio   Escritorio     @relation(fields: [escritorioId], references: [id])
  numero       String
  tribunal     String?
  area         String?
  tipoAcao     String?
  status       StatusProcesso @default(ATIVO)
  tipo         String?
  titulo       String?
  descricao    String?        @db.Text
  valor        Decimal?
  fase         String?
  dataInicio   DateTime?
  dataPrazo    DateTime?
  deletedAt    DateTime?

  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  responsavelId String?
  responsavel   Usuario? @relation("ResponsavelProcesso", fields: [responsavelId], references: [id])
  camposCustom  Json?
  driveFolderId String?
  drivePastas   Json?

  movimentacoes          Movimentacao[]
  documentos             Documento[]
  tarefas                Tarefa[]
  eventos                Evento[]
  interacoesIA           InteracaoIA[]
  mensagensPortal        MensagemPortal[]
  aprovacoesPortal       AprovacaoPortal[]
  entradasTempo          EntradaTempo[]
  mensagensWhatsapp      WhatsappMessage[]
  monitoramentosDatajud  DatajudMonitoramento[]
  intimacoes             Intimacao[]
  atendimentos           Atendimento[]
  prazos                 Prazo[]
  protocolos             Protocolo[]
  participacoes          ParticipacaoProcesso[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  linhasProducao         LinhaProcesso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([numero])
  @@index([clienteId])
  @@map("processes")
}

enum StatusProcesso {
  ATIVO
  ARQUIVADO
  ENCERRADO
  SUSPENSO
}

// ─── Movimentações / Andamentos ───────────────────────────────────────────────

model Movimentacao {
  id         String   @id @default(uuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])
  data       DateTime
  descricao  String   @db.Text
  fonte      String   @default("manual")
  lida       Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([processoId])
  @@map("movements")
}

// ─── Tarefas ─────────────────────────────────────────────────────────────────

model Tarefa {
  id            String       @id @default(uuid())
  escritorioId  String
  escritorio    Escritorio   @relation(fields: [escritorioId], references: [id])
  titulo        String
  descricao     String?      @db.Text
  status        StatusTarefa @default(PENDENTE)
  prioridade    Prioridade   @default(MEDIA)
  dataPrazo     DateTime?
  dataConclusa  DateTime?
  processoId    String?
  processo      Processo?    @relation(fields: [processoId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation("TarefasAtribuidas", fields: [responsavelId], references: [id])
  deletedAt     DateTime?

  entradasTempo EntradaTempo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([processoId])
  @@map("tasks")
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

// ─── Prazos ──────────────────────────────────────────────────────────────────

model Prazo {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  descricao    String
  tipo         String     @default("judicial")
  dataPrazo    DateTime
  status       String     @default("pendente")
  processoId   String?
  processo     Processo?  @relation(fields: [processoId], references: [id])
  deletedAt    DateTime?

  // Etapa 4: prazo nascido da publicação (DJEN) ou da nomeação dativa
  origem          String? // DJEN | AJG | DATIVA_ACEITE | MANUAL
  intimacaoId     String?
  eventoId        String?
  responsaveisIds String[]  @default([])
  conferir        Boolean   @default(false)
  diasPrazo       Int?
  contagem        String? // UTEIS | CORRIDOS
  dataInicio      DateTime?
  memoriaCalculo  Json?
  cumpridoEm      DateTime?
  cumpridoPorId   String?
  alerta3dEm      DateTime?
  alertaDiaEm     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([processoId])
  @@index([escritorioId, status, dataPrazo])
  @@map("prazos")
}

// ─── Documentos ──────────────────────────────────────────────────────────────

model Documento {
  id             String     @id @default(uuid())
  escritorioId   String
  escritorio     Escritorio @relation(fields: [escritorioId], references: [id])
  processoId     String?
  processo       Processo?  @relation(fields: [processoId], references: [id])
  nome           String
  tipo           String?
  status         String     @default("ativo")
  caminho        String?
  url            String?
  tamanho        Int?
  mimeType       String?
  versao         Int        @default(1)
  urlAssinatura  String?
  dataAssinatura DateTime?
  categoria      String?
  deletedAt      DateTime?

  // Etapa 3: arquivos do caso no armazenamento do escritório (Google Drive)
  clienteId        String?
  provedor         String? // GOOGLE_DRIVE | LOCAL | SUPABASE
  arquivoExternoId String?
  hashSha256       String?
  origem           String? // UPLOAD | GERADO | ASSINADO | WHATSAPP
  etapaId          String?
  itemChecklistId  String?
  enviadoPorId     String?

  createdAt DateTime @default(now())

  @@index([escritorioId])
  @@index([processoId])
  @@map("documents")
}

// ─── Agenda ──────────────────────────────────────────────────────────────────

model Evento {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  processoId   String?
  processo     Processo?  @relation(fields: [processoId], references: [id])
  clienteId    String?
  cliente      Cliente?   @relation(fields: [clienteId], references: [id])
  criadoPorId  String
  criadoPor    Usuario    @relation("EventosCriados", fields: [criadoPorId], references: [id])

  titulo     String
  descricao  String?    @db.Text
  data       DateTime
  dataFim    DateTime?
  tipo       TipoEvento @default(PRAZO)
  diaInteiro Boolean    @default(false)
  local      String?
  cor        String?

  notificarEm       DateTime?
  notificarAntesMin Int?      @default(30)
  notificarEmail    Boolean   @default(true)
  notificarWhatsapp Boolean   @default(false)

  recorrencia    String?
  recorrenciaFim DateTime?

  googleEventId    String?
  googleCalendarId String?

  notificacaoEnviada Boolean      @default(false)
  status             StatusEvento @default(PENDENTE)
  concluidoEm        DateTime?

  responsaveis EventoResponsavel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([data])
  @@index([clienteId])
  @@index([processoId])
  @@map("calendar_events")
}

model EventoResponsavel {
  id            String  @id @default(uuid())
  eventoId      String
  evento        Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario @relation("EventosResponsavel", fields: [usuarioId], references: [id])
  // Etapa 4: cópia do evento no Google Agenda deste advogado
  googleEventId String?
  // Controle de prazos (20/11/2026): alerta D-3 do prazo, como na planilha
  googleEventIdD3 String?

  @@unique([eventoId, usuarioId])
  @@map("event_responsibles")
}

enum TipoEvento {
  PRAZO
  AUDIENCIA
  REUNIAO
  TAREFA
  OUTRO
}

enum StatusEvento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

// ─── Interações com IA ───────────────────────────────────────────────────────

model InteracaoIA {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId    String?
  usuario      Usuario?   @relation(fields: [usuarioId], references: [id])
  processoId   String?
  processo     Processo?  @relation(fields: [processoId], references: [id])
  sessaoId     String?
  tipo         String     @default("chat")
  input        String     @db.Text
  output       String     @db.Text
  modelo       String
  tokens       Int        @default(0)

  createdAt DateTime @default(now())

  @@index([escritorioId])
  @@map("ai_interactions")
}

// ─── Tokens de Refresh ───────────────────────────────────────────────────────

model TokenRefresh {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("refresh_tokens")
}

// ─── Configurações ───────────────────────────────────────────────────────────

model Configuracao {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  chave        String
  valor        Json
  tipo         String     @default("global")

  updatedAt DateTime @updatedAt

  @@unique([escritorioId, chave])
  @@map("settings")
}

// ─── Log de Auditoria ────────────────────────────────────────────────────────

model LogAuditoria {
  id           BigInt     @id @default(autoincrement())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId    String?
  usuario      Usuario?   @relation(fields: [usuarioId], references: [id])
  acao         String
  tipoEntidade String?
  idEntidade   String?
  ipAddress    String?
  userAgent    String?
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([escritorioId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Atendimentos ─────────────────────────────────────────────────────────────

model Atendimento {
  id           String     @id @default(uuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  clienteId    String
  cliente      Cliente    @relation(fields: [clienteId], references: [id])
  processoId   String?
  processo     Processo?  @relation(fields: [processoId], references: [id])

  status          String    @default("novo")
  area            String?
  tipoAcao        String?
  valorAcao       Decimal?
  tipoHonorario   String?
  valorHonorario  Decimal?
  percentualExito Decimal?
  formaPagamento  String?
  parcelamento    Boolean   @default(false)
  numParcelas     Int?
  vencimento1Parc DateTime?
  envelopeId      String?
  menorId         String?
  questionario    Json?

  lancamentosFinanceiros LancamentoFinanceiro[]
  menorRepresentado      MenorRepresentado?
  pastaCliente           PastaCliente?
  registrosCrm           RegistroCrm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([clienteId])
  @@map("atendimentos")
}

model MenorRepresentado {
  id              String      @id @default(uuid())
  clienteId       String
  atendimentoId   String      @unique
  atendimento     Atendimento @relation(fields: [atendimentoId], references: [id])
  nome            String
  dataNascimento  DateTime?
  cpf             String?
  rg              String?
  tipoResponsavel String?

  createdAt DateTime @default(now())

  @@map("menores_representados")
}

// ─── Financeiro ──────────────────────────────────────────────────────────────

model LancamentoFinanceiro {
  id            String       @id @default(uuid())
  escritorioId  String
  escritorio    Escritorio   @relation(fields: [escritorioId], references: [id])
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  atendimentoId String?
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id])
  processoId    String?
  processo      Processo?    @relation(fields: [processoId], references: [id])

  // FIXO | EXITO | SUCUMBENCIA | MENSALIDADE | POR_ATO | DATIVA | REEMBOLSO
  tipoHonorario     String?
  // Taxa cobrada pelo meio de pagamento (Asaas: value - netValue)
  taxaGateway       Decimal?      @db.Decimal(12, 2)
  // ASAAS | ALVARA | ESTADO | MANUAL
  origemRecebimento String?
  itensRepasse      ItemRepasse[]

  descricao         String
  valor             Decimal
  tipo              String // receita | despesa
  status            String    @default("pendente")
  formaPagamento    String?
  numParcelas       Int?
  vencimento        DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  data              DateTime  @default(now())
  externalPaymentId String?
  deletedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@index([clienteId])
  @@index([processoId])
  @@map("lancamentos_financeiros")
}

// ─── Histórico de Status ──────────────────────────────────────────────────────

model HistoricoStatus {
  id             String      @id @default(uuid())
  escritorioId   String?
  escritorio     Escritorio? @relation(fields: [escritorioId], references: [id])
  entidade       String
  entidadeId     String
  statusAnterior String?
  statusNovo     String
  origem         String?
  metadata       Json?
  timestamp      DateTime    @default(now())

  @@index([entidadeId])
  @@map("status_historico")
}

// ─── Pasta do Cliente ─────────────────────────────────────────────────────────

model PastaCliente {
  id            String      @id @default(uuid())
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  atendimentoId String      @unique
  atendimento   Atendimento @relation(fields: [atendimentoId], references: [id])
  nome          String
  status        String      @default("ativa")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pastas_clientes")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model RegistroCrm {
  id            String       @id @default(uuid())
  escritorioId  String
  escritorio    Escritorio   @relation(fields: [escritorioId], references: [id])
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  atendimentoId String?
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id])
  tipo          String
  titulo        String
  descricao     String?      @db.Text
  status        String       @default("aberto")
  etapa         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escritorioId])
  @@map("crm_records")
}

// ─── Portal do Cliente ────────────────────────────────────────────────────────

model UsuarioPortal {
  id            String    @id @default(uuid())
  email         String    @unique
  senhaHash     String?
  tokenConvite  String?   @unique
  tokenExpiraEm DateTime?
  ativadoEm     DateTime?
  ativo         Boolean   @default(false)
  ultimoLoginEm DateTime?

  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  mensagens    MensagemPortal[]
  aprovacoes   AprovacaoPortal[]
  respostasNps RespostaNps[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_portal_users")
}

model MensagemPortal {
  id        String  @id @default(uuid())
  conteudo  String
  anexoUrl  String?
  lida      Boolean @default(false)
  remetente String

  portalUserId String?
  portalUser   UsuarioPortal? @relation(fields: [portalUserId], references: [id])
  processoId   String?
  processo     Processo?      @relation(fields: [processoId], references: [id])
  usuarioId    String?
  usuario      Usuario?       @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@map("portal_messages")
}

model AprovacaoPortal {
  id           String    @id @default(uuid())
  titulo       String
  descricao    String
  tipo         String
  status       String    @default("pendente")
  comentario   String?
  respondidoEm DateTime?

  portalUserId String
